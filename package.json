{
  "name": "harness-emulator",
  "version": "0.1.0",
  "description": "Scripted chat interface in the style of an AI coding agent, driven by YAML scenarios, for reliable live demos.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funkolab/harness-emulator.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "build": "bun run --bun tsc --noEmit && bun run --bun vite build",
    "test": "bun test",
    "package": "bun scripts/package.mjs",
    "package:all": "bun scripts/package.mjs --all",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "marked": "^16.3.0",
    "dompurify": "^3.4.17",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.2",
    "@types/node": "^24.6.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.7"
  },
  "packageManager": "bun@1.4.2"
}
